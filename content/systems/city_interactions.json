      "operations": [
        {"operation": "time.advance", "payload": {"minutes": 60}},
        {"operation": "skill.add_experience", "payload": {"skill": "public_speaking", "experience": 85, "activity_difficulty": 15}},
        {"operation": "attribute.adjust", "payload": {"attribute": "confidence", "amount": 1}},
        {"operation": "need.adjust", "payload": {"need": "stress", "amount": -2}}
      ]
    },
    {
