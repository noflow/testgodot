{
  "format_version": 1,
  "package_id": "port_alder_simulation_events",
  "event_envelope": {
    "required": ["event_id", "sequence", "game_timestamp", "operation", "source", "payload"],
    "optional": ["target", "caused_by", "random_seed", "transaction_id"],
    "rules": ["sequence_is_monotonic", "payload_is_declarative", "random_results_store_seed_and_result", "operation_is_atomic"]
  },
  "operations": [
    {"id": "time.advance", "payload": ["minutes_or_blocks"], "effects": ["clock", "needs_tick", "schedule_tick", "due_events"], "checkpoint": "after"},
    {"id": "need.adjust", "payload": ["need", "amount"], "range": [0, 100], "clamp": true},
    {"id": "attribute.adjust", "payload": ["attribute", "amount"], "range": [0, 250], "clamp": true},
    {"id": "skill.add_experience", "payload": ["skill", "experience", "activity_difficulty"], "range": [0, 250], "checks": ["trivial_activity_decay", "breakthrough_threshold", "mastery_challenge"]},
    {"id": "reputation.adjust", "payload": ["category", "amount", "reason"], "range": [-100, 100], "clamp": true},
    {"id": "relationship.adjust_meter", "payload": ["character_id", "meter", "amount", "reason"], "range": [0, 100], "checks": ["level_threshold", "chapter_prerequisites", "hard_boundaries"]},
    {"id": "relationship.set_agreement", "payload": ["character_id", "agreement", "mutual_acknowledgment"], "checks": ["adult_eligibility", "conversation_or_event_source"]},
    {"id": "relationship.record_date", "payload": ["character_id", "date_record"], "checks": ["adult_eligibility", "unique_date_id"], "effects": ["dating_history", "relationship_stage"]},
    {"id": "relationship.record_conflict", "payload": ["character_id", "conflict_record"], "checks": ["unique_conflict_id"], "effects": ["conflict_history", "agreement_state"]},
    {"id": "memory.create", "payload": ["character_id", "memory_id", "importance", "tags"], "deduplicate_by": ["character_id", "memory_id"]},
    {"id": "memory.expire", "payload": ["character_id", "memory_id"], "checks": ["memory_is_expirable"]},
    {"id": "quest.discover", "payload": ["quest_id", "discovery_source"], "checks": ["quest_exists", "not_terminal"], "effects": ["discovered_state", "discovery_history"]},
    {"id": "quest.set_available", "payload": ["quest_id", "available"], "checks": ["quest_discovered", "not_terminal"], "effects": ["offer_state"]},
    {"id": "quest.accept", "payload": ["quest_id", "decision_source"], "checks": ["quest_available", "gates_rechecked"], "effects": ["active_state", "decision_history"]},
    {"id": "quest.postpone", "payload": ["quest_id", "decision_source"], "checks": ["quest_available"], "effects": ["discovered_state", "postponed_state", "decision_history"]},
    {"id": "quest.decline", "payload": ["quest_id", "decision_source"], "checks": ["quest_available"], "effects": ["deferred_state", "decision_history"]},
    {"id": "quest.start", "payload": ["quest_id"], "checks": ["activation", "prerequisites", "not_already_active_or_complete"]},
    {"id": "quest.set_tracked", "payload": ["quest_id", "tracked"], "checks": ["quest_active"], "effects": ["player_tracker_only"]},
    {"id": "quest.objective_complete", "payload": ["quest_id", "objective_id"], "checks": ["quest_active", "objective_valid"]},
    {"id": "quest.complete", "payload": ["quest_id", "branch_id"], "effects": ["completion_effects", "history", "notifications"]},
    {"id": "quest.fail_or_defer", "payload": ["quest_id", "result", "reason"], "effects": ["failure_effects", "history", "notifications"]},
    {"id": "conversation.begin", "payload": ["conversation_id", "start_node", "participants"], "checks": ["activation", "participants_available", "repetition_rules"]},
    {"id": "conversation.choose", "payload": ["conversation_id", "node_id", "choice_id"], "effects": ["choice_effects", "next_node", "seen_nodes"]},
    {"id": "conversation.end", "payload": ["conversation_id", "outcome"], "effects": ["completion_effects", "cooldown", "once_only_flag"]},
    {"id": "calendar.schedule", "payload": ["calendar_event"], "checks": ["valid_date", "valid_blocks", "participants_exist"], "effects": ["conflict_detection", "reminder_generation"]},
    {"id": "calendar.cancel_or_reschedule", "payload": ["event_id", "new_time_or_cancel", "notice_minutes"], "effects": ["participant_reactions", "calendar_update"]},
    {"id": "calendar.arrival", "payload": ["event_id", "arrival_timestamp"], "effects": ["punctuality_result", "reliability", "quest_or_relationship_consequence"]},
    {"id": "travel.begin", "payload": ["origin", "destination", "mode", "route"], "checks": ["route_valid", "mode_unlocked", "funds", "safety"]},
    {"id": "travel.complete", "payload": ["destination", "minutes", "cost", "delay"], "effects": ["location", "clock", "ledger", "weather_exposure"]},
    {"id": "economy.transaction", "payload": ["account", "amount", "type", "category", "description"], "checks": ["account_exists", "funds_or_credit_available"], "effects": ["ledger_append", "balance"]},
    {"id": "economy.process_recurring", "payload": ["recurring_id", "due_date"], "effects": ["payment_or_missed_payment", "next_due_date"]},
    {"id": "economy.payday", "payload": ["job_id", "gross", "tips", "withholding", "net"], "effects": ["ledger_append", "account_balance", "income_history"]},
    {"id": "housing.acquire", "payload": ["listing_id", "contract"], "checks": ["listing_exists", "not_already_acquired", "qualification_verified"], "effects": ["lease_or_ownership_record", "recurring_housing_obligation"]},
    {"id": "housing.move", "payload": ["listing_id", "residence", "room", "household", "storage_access", "move_record"], "checks": ["property_acquired_or_family_home"], "effects": ["residence", "household", "inventory_access", "world_location", "move_history"]},
    {"id": "inventory.add", "payload": ["container_id", "item_id", "quantity", "item_state"], "checks": ["item_exists", "capacity", "stack_limit"]},
    {"id": "inventory.remove", "payload": ["container_id", "item_id", "quantity"], "checks": ["quantity_owned"]},
    {"id": "inventory.transfer", "payload": ["from_container", "to_container", "item_id", "quantity"], "checks": ["access", "capacity"]},
    {"id": "inventory.equip", "payload": ["item_id", "wardrobe_slot"], "checks": ["item_owned", "slot_matches"], "effects": ["outfit_recalculation"]},
    {"id": "inventory.clean_container", "payload": ["container_id", "cleanliness"], "checks": ["container_exists", "clothing_present"], "effects": ["clothing_cleanliness"]},
    {"id": "phone.append_message", "payload": ["character_id", "message"], "checks": ["known_contact", "message_id", "sender"], "effects": ["thread_update", "unread_state"]},
    {"id": "phone.mark_thread_read", "payload": ["character_id"], "checks": ["known_contact"], "effects": ["unread_state"]},
    {"id": "npc.meet", "payload": ["character_id", "interaction", "location"], "checks": ["character_exists", "same_location", "introduction_before_contact"], "effects": ["npc_discovery", "meeting_history", "optional_phone_contact"]},
    {"id": "health.add_condition", "payload": ["condition_id", "severity", "known_to_player"], "effects": ["symptoms", "treatment_options", "records"]},
    {"id": "health.treat", "payload": ["condition_id", "treatment_id", "provider"], "checks": ["treatment_available", "funds_or_coverage"]},
    {"id": "health.screening_result", "payload": ["screening_type", "result", "disclosure_state"], "privacy": "private_health_record"},
    {"id": "alcohol.consume", "payload": ["item_id", "servings"], "effects": ["inebriation", "hydration", "inhibition", "safety_checks"]},
    {"id": "alcohol.metabolize", "payload": ["elapsed_minutes"], "effects": ["inebriation_decay", "hangover_evaluation"]},
    {"id": "fertility.exposure_check", "payload": ["adult_a", "adult_b", "protection", "health_context", "random_result"], "checks": ["adult_eligibility", "consent_recorded"], "privacy": "private_reproductive_record"},
    {"id": "pregnancy.establish", "payload": ["pregnant_character", "other_parent", "conception_date", "plurality"], "effects": ["pregnancy_record", "care_calendar", "relationship_reactions"], "rules": ["plurality_is_one_or_twins", "pregnancy_loss_not_supported"]},
    {"id": "pregnancy.advance", "payload": ["pregnancy_id", "day"], "effects": ["stage", "symptoms", "appointments", "due_date"]},
    {"id": "birth.complete", "payload": ["pregnancy_id", "children"], "effects": ["child_records", "household", "custody", "parent_relationships"]},
    {"id": "education.enroll", "payload": ["program", "load", "courses", "tuition_plan"], "effects": ["calendar", "student_status", "allowance", "rent_waiver"]},
    {"id": "education.attendance", "payload": ["course_id", "status", "performance"], "effects": ["attendance_record", "grade_component", "skill_experience"]},
    {"id": "education.grade", "payload": ["course_id", "assessment", "score"], "effects": ["gradebook", "reputation", "course_progress"]},
    {"id": "employment.apply", "payload": ["job_id", "resume_snapshot", "availability_snapshot"], "effects": ["application_record", "screening_schedule"]},
    {"id": "employment.interview", "payload": ["job_id", "score_breakdown", "outcome"], "effects": ["application_state", "offer_or_rejection", "reputation"]},
    {"id": "employment.accept_offer", "payload": ["job_id", "schedule_id", "start_date"], "effects": ["active_job", "calendar", "probation"]},
    {"id": "employment.shift", "payload": ["job_id", "attendance", "performance"], "effects": ["hours_worked", "performance_record", "pay_accrual"]},
    {"id": "employment.promote_or_raise", "payload": ["job_id", "new_title", "new_pay"], "checks": ["requirements", "opening_if_promotion"]},
    {"id": "world.weather_update", "payload": ["date", "condition", "temperature", "precipitation", "wind"], "effects": ["forecast", "travel", "outfit_requirements"]},
    {"id": "world.store_restock", "payload": ["store_id", "stock_changes"], "effects": ["store_state"]},
    {"id": "world.unlock_location", "payload": ["location_id"], "effects": ["travel_routes", "hidden_locations_remain_hidden"]},
    {"id": "world.discover_location", "payload": ["location_id", "discovery_source", "character_id", "room_ids"], "effects": ["map", "travel_routes", "residence_access", "optional_room_grants", "notification"]},
    {"id": "simulation.daily_tick", "payload": ["date"], "effects": ["aging_checks", "health", "freshness", "schedules", "bills", "notifications"]},
    {"id": "simulation.weekly_tick", "payload": ["week_number"], "effects": ["allowance", "paydays", "recurring_rules", "schedule_rollover"]},
    {"id": "simulation.monthly_tick", "payload": ["month"], "effects": ["rent", "interest", "child_support", "housing", "budget_summary"]},
    {"id": "save.checkpoint", "payload": ["reason"], "effects": ["flush_pending_events", "write_atomic_save"]}
  ],
  "processing": {
    "order": ["validate", "reserve_random_result", "apply_atomic_changes", "append_event_log", "emit_notifications", "checkpoint_if_required"],
    "failure": "rollback_entire_transaction",
    "maximum_recent_events_in_save": 500,
    "older_events": "summarize_into_history_counters",
    "same_timestamp_tiebreaker": "sequence"
  }
}
