        {"id": "encourage_patience", "condition": {"flag": "lily.supported_research_first"}, "effects": [{"operation": "schedule_event", "value": "lily_advisor_appointment"}, {"operation": "add_meter", "character": "lily_hale", "meter": "respect", "value": 3}]}
      ],
