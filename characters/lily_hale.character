      "title": "One Year Ahead",
      "summary": "Help Lily confront her doubts about Social Sciences and decide whether to change programs.",
      "discovery": {"policy": "offer", "source": "prior_quest_branch"},
      "requirements": [{"type": "relationship", "character_id": "lily_hale", "meter": "trust", "minimum": 40, "visibility": "visible", "description": "Lily needs enough trust to share her uncertainty about college."}],
      "activation": {"event": "quest_completed", "quest": "opening_future_choice", "earliest_block": "lunch"},
      "availability": {"location": "hale_home.kitchen", "days": ["opening_tuesday", "wednesday", "friday"], "blocks": ["lunch", "evening", "late_evening"]},
      "objectives": [
        {"id": "talk_in_kitchen", "text": "Talk to Lily in the kitchen.", "completion": {"event": "conversation_completed", "conversation": "lily_program_doubts"}},
        {"id": "review_programs", "text": "Send Lily information about two possible programs.", "completion": {"event": "phone_content_shared", "recipient": "lily_hale", "tag": "westshore_program", "minimum": 2}},
        {"id": "follow_up", "text": "Check in after Lily reviews the options.", "completion": {"event": "text_thread_completed", "thread": "lily_program_followup"}}
      ],
