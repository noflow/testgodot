  "quests": [
    {
      "id": "a_quiet_check_in",
      "category": "character_story",
      "title": "A Quiet Check-In",
      "summary": "Catch up with Dad after making your first decision about the future.",
      "discovery": {"policy": "offer", "source": "prior_quest_branch"},
      "requirements": [{"type": "relationship", "character_id": "daniel_hale", "meter": "respect", "minimum": 40, "visibility": "visible", "description": "Daniel needs enough mutual respect for an honest adult conversation."}],
      "activation": {"event": "quest_completed", "quest": "opening_future_choice", "earliest_block": "evening"},
      "availability": {"location": "hale_home.living_room", "blocks": ["evening", "late_evening"]},
      "objectives": [
        {"id": "talk_with_daniel", "text": "Talk with Dad in the living room after work.", "completion": {"event": "conversation_completed", "conversation": "daniel_quiet_check_in"}}
      ],
      "branches": [],
      "completion_effects": [],
      "failure": {"mode": "cannot_fail"}
    }
  ],
  "conversations": [
    {
      "id": "daniel_quiet_check_in",
      "title": "A Quiet Check-In",
      "type": "standard_topic",
      "start_node": "daniel_opening",
      "activation": {"quest_active": "a_quiet_check_in", "location": "hale_home.living_room", "blocks": ["evening", "late_evening"]},
      "repetition": {"once_only": true},
      "nodes": {
        "daniel_opening": {"speaker": "daniel_hale", "line": "Your mom said you picked a direction. I figured I'd ask how you're feeling before the whole house starts giving advice.", "next": "player_answer"},
        "player_answer": {"speaker": "player", "choices": [
          {"id": "hopeful", "text": "Nervous, but I think I made the right start.", "tone": ["honest"], "effects": [{"operation": "add_meter", "character": "daniel_hale", "meter": "trust", "value": 2}], "next": "daniel_hopeful"},
          {"id": "uncertain", "text": "Honestly, I still don't know what I'm doing.", "tone": ["vulnerable"], "effects": [{"operation": "add_meter", "character": "daniel_hale", "meter": "comfort", "value": 2}], "next": "daniel_uncertain"},
          {"id": "deflect", "text": "Mom gave you the full report already, didn't she?", "tone": ["playful"], "effects": [{"operation": "add_meter", "character": "daniel_hale", "meter": "friendship", "value": 1}], "next": "daniel_deflect"}
        ]},
        "daniel_hopeful": {"speaker": "daniel_hale", "line": "Nerves mean you understand it matters. They don't mean the choice was wrong.", "next": "daniel_advice"},
        "daniel_uncertain": {"speaker": "daniel_hale", "line": "Good. Anyone who claims they had life figured out at eighteen is editing the story.", "next": "daniel_advice"},
        "daniel_deflect": {"speaker": "daniel_hale", "line": "There may have been a briefing. Charts were narrowly avoided.", "next": "daniel_advice"},
        "daniel_advice": {"speaker": "daniel_hale", "line": "Give the plan an honest try. If it needs changing later, change it because you learned something—not because the first day was hard.", "next": "daniel_close"},
        "daniel_close": {"speaker": "daniel_hale", "line": "That's the entire speech. I kept it under the family limit.", "effects": [{"operation": "complete_objective", "quest": "a_quiet_check_in", "objective": "talk_with_daniel"}, {"operation": "complete_quest", "quest": "a_quiet_check_in"}, {"operation": "create_memory", "character": "daniel_hale", "value": "first_adult_check_in"}], "next": null}
      }
    }
  ],
  "text_messages": [
    {
      "id": "daniel_opening_checkin",
      "trigger": {"sandbox_activated": true},
      "sender": "daniel_hale",
      "text": "Heard you made a decision. First step is usually the worst one. Car keys are still ask-first, by the way.",
      "quick_replies": [
        {"text": "Thanks, Dad.", "tone": ["supportive"], "effects": [{"operation": "add_meter", "character": "daniel_hale", "meter": "comfort", "value": 1}]},
        {"text": "Can I use the car later?", "tone": ["responsible"]},
        {"text": "You really know how to inspire someone.", "tone": ["playful"], "effects": [{"operation": "add_meter", "character": "daniel_hale", "meter": "friendship", "value": 1}]}
      ]
    }
  ],
  "outcomes": ["stronger_adult_family_bond", "shared_garage_project", "quiet_mutual_respect"],
