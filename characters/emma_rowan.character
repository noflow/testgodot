        {"id": "close_friendship", "condition": {"flag": "emma.walk_friendship_focus"}, "effects": [{"operation": "add_meter", "character": "emma_rowan", "meter": "friendship", "value": 6}, {"operation": "add_meter", "character": "emma_rowan", "meter": "trust", "value": 3}]}
      ],
