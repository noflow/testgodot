        {"id": "answer_invitation", "text": "Reply to Emma's invitation.", "completion": {"event": "text_replied", "thread": "emma_walk_invitation"}},
        {"id": "schedule_walk", "text": "Add the Alder Bay walk to your calendar.", "completion": {"event": "calendar_event_created", "tag": "date_or_hangout", "participant": "emma_rowan"}},
        {"id": "meet_emma", "text": "Meet Emma at Alder Bay Park.", "completion": {"event": "conversation_completed", "conversation": "emma_alder_bay_walk"}}
      ],
      "branches": [
