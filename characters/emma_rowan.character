      "title": "Before Everything Changes",
      "summary": "Meet Emma for a walk at Alder Bay before the semester begins.",
      "activation": {"event": "sandbox_activated"},
      "availability": {"days": ["opening_tuesday", "wednesday", "friday", "sunday"], "blocks": ["afternoon", "evening"], "location": "alder_bay.waterfront_path", "weather_excludes": ["severe_storm"]},
